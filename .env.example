# Telegram Bot
# Production token lives in Vercel env as TELEGRAM_BOT_TOKEN.
# If Firebase Functions are enabled later, also set:
# firebase functions:config:set telegram.token="your_bot_token_here"
# Optional browser-only demo fallback. Do not use for production.
VITE_TELEGRAM_BOT_TOKEN=
# Owner's personal Telegram Chat ID (for NFC check-in notifications)
# Get it by messaging @userinfobot on Telegram
VITE_OWNER_TELEGRAM_CHAT_ID=

# Firebase Client SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase SQL Connect
# The generated SDK is written to src/lib/dataconnect-generated after
# Firebase SQL Connect is enabled for the project.
VITE_FIREBASE_SQL_CONNECT_SERVICE_ID=homemaker
VITE_FIREBASE_SQL_CONNECT_LOCATION=us-central1

# Google Gemini AI
# Production key lives in Vercel env as GEMINI_API_KEY.
# If Firebase Functions are enabled later, also set:
# firebase functions:config:set gemini.key="your_gemini_api_key"
# Optional browser-only demo fallback for local receipt scanning/chat experiments.
VITE_GEMINI_API_KEY=

# Google Sheets Webhook (Apps Script deployment URL)
VITE_GOOGLE_SHEETS_WEBHOOK_URL=
