rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Attendance and Telegram logs are written by trusted server functions.
    match /attendance_logs/{logId} {
      allow read, write: if false;
    }
    // Telegram updates: only server-side (Cloud Functions) writes
    match /telegram_updates/{updateId} {
      allow read: if false;
      allow write: if false; // Only Cloud Functions can write
    }
    // User profiles and household-scoped app data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
